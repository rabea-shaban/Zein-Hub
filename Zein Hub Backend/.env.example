# Server Environment
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb://127.0.0.1:27017/zein_hub
CLIENT_URL=https://zeinhub.com

# JWT Authentication
JWT_ACCESS_SECRET=your_super_strong_production_access_secret_key_2026_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_strong_production_refresh_secret_key_2026_change_me
JWT_REFRESH_EXPIRES_IN=7d

# Initial Super Admin Seed Credentials
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@zeinhub.com
SUPER_ADMIN_PASSWORD=Admin@ZeinHub2026!
SUPER_ADMIN_PHONE=01000000000

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOG_LEVEL=info
